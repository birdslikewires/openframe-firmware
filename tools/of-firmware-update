#!/bin/bash

## of-firmware-update v26.11.9 (19th November 2026)
##  Puts the BirdsLikeWires release in $IMG on an OpenFrame's firmware chip, from any firmware
##  listed in $MANIFEST (OF1: stock O2, Verizon, Telstra; OF2: whichever stock builds it lists;
##  our releases), in an order where a power cut at any moment leaves a chip that starts.
##  Firmware it doesn't recognise is never written: a dump is saved. The model (OpenFrame 1 or
##  2) is the one the chip's boot block names; the image must be for it (of1-blw.bin or
##  of2-blw.bin beside this, unless $IMG is given). An OF2 keeps its own stock blocks 1-9 (its
##  display driver is set up for its panel, Sharp or Samsung): only blocks 9-11 are written, and
##  from stock nothing at all is erased.
##
##  of-firmware-update [--check]
##    --check  say what would be done and write nothing (exit 0 up to date, 5 update needed).
##
##  Exit status:
##    0  the chip holds the release, verified (or already did, or holds a newer one)
##    1  refused or nothing written: the chip is as it was, rebooting is safe
##    2  a write did not verify: DO NOT REBOOT OR POWER OFF; run this again (it carries on)
##    3  firmware not recognised: nothing written, a dump saved in $DUMPDIR
##    4  flash blocks are locked until the next reset: reboot, then run this again
##    5  (--check only) an update is needed
##
##  What it writes (docs/flash-order.md; the plan is fwplan.py's, $PLAN):
##    - Only blocks 9, 10 and 11. Never block 0 (NVRAM), the boot block (14, 15), or any of the
##      stock firmware's own files: the stock blocks stay as they are, and our driver does its
##      work in memory.
##    - The layout from 26.11.31: our spacer from the end of the stock files to block 10; block
##      10 holds spacer headers only (signposts the firmware's file walk follows); block 11 holds
##      our files (the version marker and BlwPlatformDxe).
##    - An update closes block 10's open signpost (one bit: the walk then stops short of block
##      11), writes block 11 out of the firmware's reach, then opens the next signpost, 24 bytes
##      on. Block 9 doesn't change.
##    - From stock firmware, or a release of the old layout (26.11.29/30, our files in block 10),
##      the same happens one level up, in block 9: block 10 and 11 are written out of reach, then
##      a signpost in block 9 opens the way. From stock nothing is erased at all.
##    - Between closing and opening, the chip starts like stock firmware (without our driver,
##      so without its fix for the internal memory's driver). A system on the internal memory
##      (MMC) would hang if its boot.nsh starts the kernel directly, so before the first write
##      this sets $WRITING and has of-bootnsh (openframe-scripts, v26.11.15 on) write boot.nsh
##      the way that starts on either firmware: BlwMmcFix.efi, then the kernel if it worked
##      (stock-like firmware), else GRUB (ours). $WRITING outlives a power cut, so of-bootnsh
##      keeps those lines on the boot after one; it goes once the chip is verified, and
##      boot.nsh is written for the firmware again. A unit started from a USB stick needs none
##      of this.
##    - Before anything is written, fwplan.py walks every state the chip will pass through, with
##      the firmware's own rules for its file list, including a byte cut off part way through
##      programming: if any state wouldn't start, nothing is written. A run cut off anywhere is
##      carried on by the next run, from what is on the chip.
##
##  Once the first write starts, nothing but finishing stops it: hangup, interrupt and terminate
##  (and a broken pipe) are ignored from then on (by the writes too), so a shutdown, a Ctrl-C or a dropped SSH session
##  can't stop it part way. (kill -9 still can; the services that run this never send it:
##  of-firmware.service and of-flash.service wait for it however long it takes. And a run cut off
##  anywhere still leaves a chip that starts.)
##
##  Settings (environment): OF_FW_IMAGE (else OF_FW_LIB/of<model>-blw.bin), OF_FW_MANIFEST, OF_FW_DUMPDIR, OF_FW_PLAN, OF_FW_WRITING,
##  OF_FW_BOOTNSH (of-bootnsh), OF_FW_BOOT (the boot directory); FH_KO=/path/to/
##  fh.ko loads a module that isn't installed. Test mode: FH=/path/to/a/1MB/file works on that file
##  (no module, no lock registers, /dev/fhp emulated); FLASH_TEST_FAULT_STEP=n with FLASH_TEST_FAULT=N
##  loses step n's write on its first N tries; FLASH_TEST_STOP=n stops (exit 9) right after step n,
##  as a power cut would; FLASH_TEST_PAUSE=seconds waits after each part, as a real chip's slower
##  writes do; OF_FW_TEST_MMC=1 takes the system to be on the internal memory. None of these
##  can touch a real chip.

set -u
# The image: OF_FW_IMAGE, else the one for the model the chip's boot block names (of1-blw.bin,
# of2-blw.bin), chosen once the chip is read.
IMG=${OF_FW_IMAGE:-}
LIB=${OF_FW_LIB:-/usr/lib/openframe-firmware}
MANIFEST=${OF_FW_MANIFEST:-/usr/lib/openframe-firmware/manifest.txt}
DUMPDIR=${OF_FW_DUMPDIR:-/var/lib/openframe-firmware}
PLAN=${OF_FW_PLAN:-/usr/lib/openframe-firmware/fwplan.py}
WRITING=${OF_FW_WRITING:-/var/lib/openframe-firmware/writing}
BOOTNSHTOOL=${OF_FW_BOOTNSH:-/usr/local/sbin/of-bootnsh}
BOOT=${OF_FW_BOOT:-/boot}
MMCFIXEFI=${OF_FW_MMCFIX:-/usr/lib/openframe/BlwMmcFix.efi}
TRIES=3
CHECK=0
case "${1:-}" in
	--check) CHECK=1 ;;
	"") ;;
	*) echo "Usage: $0 [--check]"; exit 1 ;;
esac
FH=${FH:-/dev/fh}; FHP=${FHP:-/dev/fhp}; TEST=0; [ -f "$FH" ] && { TEST=1; FHP=$FH; }
W=""
MARKER_RE='BirdsLikeWires OpenFrame EFI [0-9]+\.[0-9]+\.[0-9]+(-dev[0-9]+)? \(OF[12]\)'

say() { echo "of-firmware-update: $*"; }
refuse() { [ -n "$W" ] && rm -rf "$W"; say "STOP: $*. Nothing was written; the chip is as it was."; exit 1; }
failed() { say "FAILED: $*. DO NOT REBOOT OR POWER OFF."
	say "Run this again: it carries on from where it stopped. If it still fails, leave the unit on and get help. Dumps in $W"; exit 2; }
m() { md5sum "$1" | cut -d' ' -f1; }
blk() { dd if="$1" bs=64k skip="$2" count="$3" iflag=fullblock status=none; }
bm() { blk "$1" "$2" 1 | md5sum | cut -d' ' -f1; }
readchip() { dd if="$FH" bs=64k iflag=fullblock status=none of="$1"; }
label() { awk -v b="$1" -v h="$2" '$1 == b && $2 == h { print $3 }' "$MANIFEST" | head -1; }
teststop() { [ $TEST = 1 ] && [ "${FLASH_TEST_STOP:-}" = "$1" ] && { say "TEST: stopped after step $1"; exit 9; }; return 0; }
pause() { [ $TEST = 1 ] && [ -n "${FLASH_TEST_PAUSE:-}" ] && sleep "$FLASH_TEST_PAUSE"; return 0; }
# The system's boot.nsh, held to the lines that start the internal memory on either firmware
# while the chip is being written (see the top). Only for a system on the internal memory.
on_mmc() {
	if [ $TEST = 1 ]; then [ "${OF_FW_TEST_MMC:-}" = 1 ]; return; fi
	[[ "$(lsblk -n -o PKNAME "$(findmnt -n -o SOURCE --target "$BOOT" 2>/dev/null)" 2>/dev/null | head -1)" == mmcblk* ]]
}
bootnsh_fallback() {
	mkdir -p "$(dirname "$WRITING")" && touch "$WRITING" && sync || refuse "could not make $WRITING"
	on_mmc || return 0
	"$BOOTNSHTOOL" mac >/dev/null 2>&1
	grep -q 'BlwMmcFix\.efi' "$BOOT/boot.nsh" && grep -q 'grubq' "$BOOT/boot.nsh" ||
		refuse "boot.nsh did not take the lines that start on stock-like firmware too"
	say "boot.nsh: starting through BlwMmcFix.efi (or GRUB) until the chip is written"
}
bootnsh_restore() {
	rm -f "$WRITING"; sync
	on_mmc || return 0
	"$BOOTNSHTOOL" mac >/dev/null 2>&1 && say "boot.nsh: written for the firmware again" ||
		say "NOTE: boot.nsh could not be written for the firmware again: of-bootnsh does it at the next start"
}
# canon <chip> <out>: fwplan.py's reading of a chip ("spacer=... files=reached|unreached
# layout=block11|old"), with our spacer headers blanked in <out> so its blocks' md5s can be looked up.
canon() { python3 -I "$PLAN" canon "$1" "$2"; }
# model <image>: 1 or 2, the OpenFrame its boot block is built for, by the ROM name AMI's PEI
# core carries at 0xEA268 (driver/model.inc): 0ABPW400 on every OF1, 0ABPW005 on every good OF2.
# Nothing for anything else (the do-not-use OF2 builds say 006 and 007).
model() {
	case "$(dd if="$1" bs=1 skip=$((0xEA268)) count=8 status=none)" in
		0ABPW400) echo 1 ;; 0ABPW005) echo 2 ;;
	esac
}

[ "$(id -u)" = 0 ] || refuse "run it as root (sudo)"
[ -f "$MANIFEST" ] || refuse "no manifest at $MANIFEST"
[ -f "$PLAN" ] || refuse "no fwplan.py at $PLAN"
[ -z "$IMG" ] || [ -f "$IMG" ] || refuse "no firmware image at $IMG"
W=$(mktemp -d /tmp/of-firmware-update.XXXXXX) || { W=""; refuse "could not make a work directory"; }

if [ $TEST = 0 ]; then
	[ -e /sys/module/fh ] || modprobe fh 2>/dev/null || { [ -n "${FH_KO:-}" ] && insmod "$FH_KO"; } || refuse "could not load fh"
	for i in 1 2 3 4 5; do [ -e "$FH" ] && break; sleep 0.2; done
else
	say "TEST MODE: working on the file $FH, not the chip"
fi

for i in 1 2; do readchip "$W/pre$i.bin" || refuse "could not read the chip"; done
[ "$(m "$W/pre1.bin")" = "$(m "$W/pre2.bin")" ] || refuse "two reads of the chip differ"
MODEL=$(model "$W/pre1.bin")

# True if release $1 (a marker's version) is newer than $2, by version alone: a -devN counts
# as its release.
newer() {
	[ -n "$1" ] && [ "${1%%-*}" != "${2%%-*}" ] &&
		[ "$(printf '%s\n%s\n' "${1%%-*}" "${2%%-*}" | sort -V | tail -1)" = "${1%%-*}" ]
}

unknown() {
	mkdir -p "$DUMPDIR" 2>/dev/null
	D="$DUMPDIR/of${MODEL:-x}-firmware-$(date -u +%Y%m%d)-$(m "$W/pre1.bin" | cut -c1-8).bin"
	if cp "$W/pre1.bin" "$D" 2>/dev/null; then say "saved a dump of this firmware to $D"; else say "could not save a dump in $DUMPDIR"; fi
	say "this firmware is not one we know ($*), so it is left alone. Nothing was written."
	rm -rf "$W"; exit 3
}
[ -n "$MODEL" ] || unknown "its boot block names no OpenFrame we know"
if [ -z "$IMG" ]; then
	IMG=$LIB/of$MODEL-blw.bin
	[ -f "$IMG" ] || { rm -rf "$W"; say "there is no firmware image for an OpenFrame $MODEL here ($IMG), so it is left alone. Nothing was written."; exit 3; }
fi

# The image: 1 MB, its md5 as shipped beside it, a BirdsLikeWires marker naming the model its
# boot block is built for, of the block-11 layout, and every block 1-15 (spacer headers blanked)
# listed in the manifest as this release's. An OF1 release is listed by its version (26.11.31),
# an OF2 release as of2-<version>, so the blocks of the two never mix. (That it is for this
# chip's model is checked once the chip is known.)
[ "$(stat -c %s "$IMG")" = 1048576 ] || refuse "$IMG is not 1 MB"
if [ -f "$IMG.md5" ]; then
	[ "$(cut -d' ' -f1 "$IMG.md5")" = "$(m "$IMG")" ] || refuse "$IMG does not match $IMG.md5"
fi
MK=$(grep -aoE "$MARKER_RE" "$IMG" | head -1)
NEW=$(echo "$MK" | awk '{print $4}')
[ -n "$NEW" ] || refuse "$IMG has no BirdsLikeWires version marker"
IMODEL=${MK##*(OF}; IMODEL=${IMODEL%)}
[ "$(model "$IMG")" = "$IMODEL" ] || refuse "$IMG says it is for an OpenFrame $IMODEL, but its boot block isn't one's"
LNEW=$NEW; [ $IMODEL = 2 ] && LNEW=of2-$NEW
IC=$(canon "$IMG" "$W/img.canon") || refuse "$IMG: $IC"
case "$IC" in *"files=reached layout=block11"*) ;; *) refuse "$IMG is not of the block-11 layout (26.11.31 on)" ;; esac
declare -a T C R
for n in $(seq 1 15); do
	[ "$(label $n "$(bm "$W/img.canon" $n)" | tr ',' '\n' | grep -cx "$LNEW")" = 1 ] ||
		refuse "the manifest does not list block $n of $IMG as $LNEW's"
	T[$n]=$(bm "$IMG" $n)
done
BLANK=$(head -c 65536 /dev/zero | tr '\0' '\377' | md5sum | cut -d' ' -f1)

CC=$(canon "$W/pre1.bin" "$W/chip.canon") || unknown "its file list: ${CC#fwplan: refused: }"
for n in $(seq 1 15); do C[$n]=$(bm "$W/chip.canon" $n); R[$n]=$(bm "$W/pre1.bin" $n); done

# The firmware it's built on: blocks 1-9 and 12-15 (spacer headers blanked) all one image's,
# stock or ours. Blocks 10 and 11 are ours, or out of the firmware's reach (fwplan.py).
for n in 14 15; do [ -n "$(label $n "${C[$n]}")" ] || unknown "its boot block (block $n) differs from any we know"; done
BASE=""
for n in 1 2 3 4 5 6 7 8 9 12 13 14 15; do
	L=$(label $n "${C[$n]}")
	[ -n "$L" ] || unknown "block $n matches no release or stock firmware we have"
	if [ -z "$BASE" ]; then BASE=$(echo "$L" | tr ',' '\n' | sort)
	else BASE=$(comm -12 <(echo "$BASE") <(echo "$L" | tr ',' '\n' | sort)); fi
	[ -n "$BASE" ] || unknown "its blocks are from different firmware (block $n is $L's)"
done
# Our files, where the firmware reaches them: a release we know.
CUR=""
case "$CC" in
	*"files=reached layout=block11"*) FB=11 ;;
	*"files=reached layout=old"*) FB=10 ;;
	*) FB="" ;;
esac
if [ -n "$FB" ]; then
	CMK=$(blk "$W/pre1.bin" $FB 1 | grep -aoE "$MARKER_RE" | head -1)
	CUR=$(echo "$CMK" | awk '{print $4}')
	if [ -z "$(label $FB "${R[$FB]}")" ]; then
		# Our files from a release newer than this updater and its manifest (an older stick,
		# or a package not yet upgraded, on a chip a later one updated): the firmware's own
		# marker, for this model, says so. Left alone, as a newer release we know would be.
		if [ "$FB" = 11 ] && [ "$CMK" != "${CMK%(OF$MODEL)}" ] && newer "$CUR" "$NEW"; then
			[ -e "$WRITING" ] && [ $CHECK = 0 ] && bootnsh_restore
			say "the firmware is $CUR, newer than $NEW (newer than this updater knows): left alone"; rm -rf "$W"; exit 0
		fi
		unknown "block $FB (our files) matches no release we have"
	fi
	if [ $FB = 11 ] && [ "${R[11]}" = "${T[11]}" ]; then
		[ -e "$WRITING" ] && [ $CHECK = 0 ] && bootnsh_restore    # an earlier run, cut off after its last write
		say "the firmware is $NEW: nothing to do"; rm -rf "$W"; exit 0
	fi
fi
# The image must be for this model (an OF1's release on an OF2 would start, but say OF1).
[ "$IMODEL" = "$MODEL" ] || refuse "$IMG is for an OpenFrame $IMODEL and this is an OpenFrame $MODEL"
# Never go backwards: a chip whose own marker says it is newer than this image is left alone.
if newer "$CUR" "$NEW"; then
	[ -e "$WRITING" ] && [ $CHECK = 0 ] && bootnsh_restore
	say "the firmware is $CUR, newer than $NEW: left alone"; rm -rf "$W"; exit 0
fi

# What the chip is now, block by block, where it differs from the image: each block named by the
# image the manifest has it from ("9:o2-stock" says which carrier's firmware it is), "blank",
# "signposts" (block 10 holding only spacer headers), or "torn" (ours, out of the firmware's
# reach, part way through an earlier run).
DESC=""
for n in $(seq 1 15); do
	[ "${R[$n]}" = "${T[$n]}" ] && continue
	# Blocks 10 and 11 by what's in them; the others by what they are without our spacer.
	case $n in 10|11) L=$(label $n "${R[$n]}") ;; *) L=$(label $n "${C[$n]}") ;; esac
	if [ "${R[$n]}" = "$BLANK" ]; then DESC="$DESC $n:blank"
	elif [ $n = 10 ] && [ -z "$L" ] && [ "${C[10]}" = "$BLANK" ]; then DESC="$DESC 10:signposts"
	elif [ -n "$L" ]; then DESC="$DESC $n:$(echo "$L" | cut -d, -f1)$(echo "$L" | grep -q , && echo +)"
	else DESC="$DESC $n:torn"; fi
done

POUT=$(python3 -I "$PLAN" plan "$W/pre1.bin" "$IMG" "$W/plan") || refuse "no write order for this chip could be proven safe (${POUT#fwplan: refused: })"
PARTS=$(echo "$POUT" | sed -n 's/^fwplan: [0-9]* steps* (\([0-9 ]*\)).*/\1/p')
PROVEN=$(echo "$POUT" | sed -n 's/.*, \([0-9]*\) states proven.*/\1/p')
[ -s "$W/plan/steps.txt" ] && [ -n "$PARTS" ] || refuse "fwplan.py made no plan ($POUT)"
# Named by our marker where the firmware reaches it, else by the stock firmware it is built on
# (an OF2 release shares its blocks 1-9 with the stock image it was made from).
NOW=$CUR; [ -n "$NOW" ] || NOW=$(echo "$BASE" | grep -vE '^(of2-)?[0-9]+\.[0-9]+\.[0-9]+' | head -1); [ -n "$NOW" ] || NOW=$(echo "$BASE" | head -1)
say "firmware now ($NOW): blocks that differ from $NEW:$DESC"
say "plan: write blocks $PARTS ($PROVEN states checked: a power cut at any point leaves a chip that starts)"
if [ $CHECK = 1 ]; then rm -rf "$W"; exit 5; fi

if [ $TEST = 0 ]; then
	KO=$(find /lib/modules/$(uname -r) -name 'gma500_gfx.ko*' | head -1)
	case "$KO" in *.xz) KCAT=xzcat ;; *.zst) KCAT=zstdcat ;; *.gz) KCAT=zcat ;; *) KCAT=cat ;; esac
	# grep -q stops reading at the first match, so the decompressor's write fails with
	# "Broken pipe": harmless (it means the fix is there), but alarming on the screen.
	[ -n "$KO" ] && $KCAT "$KO" 2>/dev/null | grep -aq "pre-programmed mode is" || refuse "this kernel's gma500 lacks the 60 Hz panel fix: install 6.18.63-4 or later first"
	# On an OpenFrame 2 our firmware leaves the panel PLL as its display driver set it, and the
	# Samsung panel's (Cisco) uses a divider older gma500s read as 0: a divide error as it
	# loads, and no display in Linux. Kernel patch 09 reads it right (and warns, once, if one
	# still reads 0: the string looked for here).
	if [ "$IMODEL" = 2 ]; then
		$KCAT "$KO" 2>/dev/null | grep -aq "PLL reads back no clock" || refuse "this kernel's gma500 lacks the OpenFrame 2 panel divider fix: install 6.18.63-9 or later first"
	fi
	LOCKED=$(python3 -c '
import mmap, os, sys
f = os.open("/dev/mem", os.O_RDONLY | os.O_SYNC)
m = mmap.mmap(f, 0x100000, mmap.MAP_SHARED, mmap.PROT_READ, offset=0xFFB00000)
print(" ".join(sorted(set(b for b in sys.argv[1:] if m[int(b) * 0x10000 + 2] & 2))))' $PARTS) || refuse "could not read the lock registers"
	if [ -n "$LOCKED" ]; then rm -rf "$W"; say "flash blocks $LOCKED are locked down until the next reset: reboot, then run this again"; exit 4; fi
	# fh must be writable and have /dev/fhp (programming without erasing): reload it if not.
	{ [ "$(cat /sys/module/fh/parameters/writable 2>/dev/null)" = Y ] && [ -e "$FHP" ]; } || {
		rmmod fh 2>/dev/null
		if [ -n "${FH_KO:-}" ]; then insmod "$FH_KO" writable=1 || refuse "could not load $FH_KO"
		else modprobe fh writable=1 || refuse "could not load fh writable"; fi
		for i in 1 2 3 4 5; do [ -e "$FH" ] && [ -e "$FHP" ] && break; sleep 0.2; done
	}
	[ "$(cat /sys/module/fh/parameters/writable 2>/dev/null)" = Y ] || refuse "fh is not writable"
	[ -e "$FHP" ] || refuse "this kernel's fh has no $FHP: update the kernel (6.18.63-5 or later)"
fi

# Before anything is written, a system on the internal memory needs an of-bootnsh that knows
# $WRITING, and BlwMmcFix.efi (without it, of-bootnsh would fall back to GRUB for good).
if on_mmc; then
	grep -q 'openframe-firmware/writing' "$BOOTNSHTOOL" 2>/dev/null ||
		refuse "this system is on the internal memory and its of-bootnsh can't hold boot.nsh safe during the update: update openframe-scripts first"
	[ -f "$MMCFIXEFI" ] || refuse "this system is on the internal memory and $MMCFIXEFI is missing"
fi

# put fh|fhp <n> <file>: write the 64 KB file to block n (fh: erase and program; fhp: program
# only). /dev/fhp is emulated in test mode: refused (nothing written) if any bit would need
# setting, else ANDed in. A test fault loses the write.
LOSE=0
put() {
	[ $LOSE = 1 ] && return 0
	if [ $TEST = 1 ] && [ "$1" = fhp ]; then
		python3 - "$FH" "$2" "$3" <<-'EOF'
		import sys
		chip, n, new = sys.argv[1], int(sys.argv[2]), open(sys.argv[3], 'rb').read()
		with open(chip, 'r+b') as f:
		    f.seek(n * 65536); was = f.read(65536)
		    if any((w & x) != x for w, x in zip(was, new)): sys.exit("fhp: a bit would need setting; nothing written")
		    f.seek(n * 65536); f.write(bytes(w & x for w, x in zip(was, new)))
		EOF
	else
		dd if="$3" of="$([ "$1" = fhp ] && echo "$FHP" || echo "$FH")" bs=64k seek="$2" count=1 iflag=fullblock conv=notrunc status=none
	fi
}
# verify <n> <md5>: two reads; block n = md5.
verify() { readchip "$W/r1.bin"; readchip "$W/r2.bin"; [ "$(bm "$W/r1.bin" $1)" = $2 ] && [ "$(bm "$W/r2.bin" $1)" = $2 ]; }

# From the first write on, only finishing stops this (see the top). PIPE too: a dropped SSH
# session or a closed reader must not stop it at its next message.
trap '' HUP INT TERM PIPE
bootnsh_fallback

NSTEPS=$(wc -l < "$W/plan/steps.txt")
i=0
while read -r OP B F; do
	i=$((i + 1))
	WANT=$(m "$W/plan/$F")
	ok=0
	for try in $(seq 1 $TRIES); do
		LOSE=0
		[ $TEST = 1 ] && [ "${FLASH_TEST_FAULT_STEP:-}" = $i ] && [ "${FLASH_TEST_FAULT:-0}" -ge $try ] && LOSE=1
		put $OP $B "$W/plan/$F" || say "step $i (block $B), try $try: the write failed"
		if verify $B $WANT; then ok=1; break; fi
		say "step $i (block $B), try $try: the read-back does not match"
	done
	[ $ok = 1 ] || failed "step $i (block $B) does not verify after $TRIES tries"
	teststop $i
	# The last step on this block in a row finishes a part of the plan.
	NB=$(sed -n "$((i + 1))p" "$W/plan/steps.txt" | awk '{print $2}')
	if [ "$NB" != "$B" ]; then say "block $B written and verified"; pause; fi
done < "$W/plan/steps.txt"
[ $i = $NSTEPS ] || failed "only $i of $NSTEPS steps were run"

for i in 1 2; do readchip "$W/post$i.bin"; done
[ "$(m "$W/post1.bin")" = "$(m "$W/post2.bin")" ] || failed "two reads of the chip differ after the update"
PC=$(canon "$W/post1.bin" "$W/post.canon") || failed "after the update: $PC"
case "$PC" in *"files=reached layout=block11"*) ;; *) failed "after the update the firmware doesn't reach our files ($PC)" ;; esac
[ "$(bm "$W/post1.bin" 11)" = "${T[11]}" ] || failed "block 11 is not $NEW's after the update"
for n in 1 2 3 4 5 6 7 8 9 12 13 14 15; do
	[ "$(bm "$W/post.canon" $n)" = "${C[$n]}" ] || failed "block $n changed more than its spacer headers"
done
cmp -s <(head -c 65536 "$W/pre1.bin") <(head -c 65536 "$W/post1.bin") || say "NOTE: block 0 (NVRAM) changed while this ran"
bootnsh_restore
say "UPDATED: the firmware is $NEW, verified (read-back $(m "$W/post1.bin")); dumps in $W"
exit 0
