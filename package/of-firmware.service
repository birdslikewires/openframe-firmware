[Unit]
Description=OpenFrame firmware update
Documentation=https://github.com/birdslikewires/openframe-firmware
# Only while an update is pending (the openframe-firmware package marks one).
ConditionPathExists=/var/lib/openframe-firmware/pending
# Before the login prompt, first-boot provisioning (of-provision runs after
# getty@tty1) and any interface: the flash comes first. On a boot with an update
# pending, of-firmware-generator also moves it ahead of basic.target, so none of the
# ordinary services (the network included) run alongside it.
Before=getty@tty1.service of-provision.service display-manager.service systemd-user-sessions.service
# After the boot splash has started, so it's up when this begins, and of-firmware-boot puts it
# away before drawing: started later, it would cover the panel. (Nothing, without Plymouth.)
After=plymouth-start.service

[Service]
Type=oneshot
ExecStart=/usr/lib/openframe-firmware/of-firmware-boot
# A flash that won't verify is tried again (ten times, then of-firmware-boot holds on its
# failure screen until switched off), and the service never times out.
TimeoutStartSec=infinity
# Nor is it stopped part way: a shutdown asked for while it writes waits for it (it and
# of-firmware-update ignore the stop signal while writing), and is never followed by a
# kill, which would stop it between blocks.
TimeoutStopSec=infinity
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
