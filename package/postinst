#!/bin/sh

# openframe-firmware postinst
#  Marks a firmware update as pending and enables of-firmware.service, which does it at the
#  next boot, before anything else starts (of-firmware-boot). Nothing is flashed here: apt
#  can run at any time, perhaps unattended, and the flash wants a quiet unit and a screen.
#  It says so, and what the next restart will do, for whoever ran apt (over SSH there's
#  nothing on the panel until then). That comes from what the firmware tells Linux (DMI);
#  the chip itself is only read at the restart, where the updater has the last word.

set -e

LIB=/usr/lib/openframe-firmware

# The release in this package for a model (1 or 2), from its image's marker; empty if none.
release() {
	grep -aoE 'BirdsLikeWires OpenFrame EFI [0-9]+\.[0-9]+\.[0-9]+(-dev[0-9]+)? \(OF[12]\)' \
		"$LIB/of$1-blw.bin" 2>/dev/null | head -1 | awk '{print $4}'
}

# True if version $1 is older than $2, a -devN coming before its release.
older() {
	dpkg --compare-versions "$(echo "$1" | sed 's/-dev/~dev/')" lt "$(echo "$2" | sed 's/-dev/~dev/')"
}

tell() {
	local NOW NEW MODEL PRODUCT
	# Building an image: there's no unit to talk about.
	if systemd-detect-virt --quiet --chroot 2>/dev/null; then
		echo "openframe-firmware: the firmware is brought up to date at the unit's first start."
		return
	fi
	NOW=$(cat /sys/class/dmi/id/bios_version 2>/dev/null || true)
	PRODUCT=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)
	case "$PRODUCT" in
		"OpenFrame 2") MODEL=2 ;;
		"OpenFrame 1") MODEL=1 ;;
		*) MODEL="" ;;
	esac
	if [ -n "$MODEL" ]; then
		NEW=$(release $MODEL)
		if [ -z "$NEW" ]; then
			echo "openframe-firmware: this package has no firmware for the OpenFrame $MODEL yet,"
			echo "  so this unit's firmware ($NOW) is left as it is."
			return
		fi
		if [ "$NOW" = "$NEW" ]; then
			echo "openframe-firmware: the firmware is already $NEW. A quick check at the next restart"
			echo "  confirms it."
			return
		fi
		if [ -n "$NOW" ] && older "$NEW" "$NOW"; then
			echo "openframe-firmware: the firmware ($NOW) is newer than this package's $NEW,"
			echo "  so it is left as it is."
			return
		fi
		echo "openframe-firmware: the firmware ($NOW) will be updated to $NEW at the next restart."
	else
		# Stock firmware publishes nothing, so the model isn't known until the chip is read.
		NEW=$(release 1)
		echo "openframe-firmware: this unit has its original firmware. At the next restart it is"
		echo "  checked and, if it's one we know, updated to BirdsLikeWires ${NEW:-firmware}."
	fi
	echo "  Nothing has been written yet, and the unit isn't restarted for you. At the restart,"
	echo "  before anything else starts, the update runs with its progress on the screen. It"
	echo "  takes a minute or two, then the unit restarts once more by itself. Don't switch it"
	echo "  off until it's back. Afterwards, /var/lib/openframe-firmware/last-flash.log says"
	echo "  what was done."
}

case "$1" in
	configure)
		mkdir -p /var/lib/openframe-firmware
		touch /var/lib/openframe-firmware/pending
		systemctl enable --quiet of-firmware.service 2>/dev/null || true
		tell || true
	;;
esac

exit 0
