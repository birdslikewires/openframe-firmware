#!/bin/bash

## of-firmware-boot v26.11.4 (17th November 2026)
##  Run at boot by of-firmware.service while a firmware update is pending (the package's
##  postinst marks one). Before the login prompt, provisioning or any interface starts, it
##  brings the firmware to the packaged release with of-firmware-update, and restarts on
##  the new firmware. Firmware it doesn't recognise is left alone (a dump is kept in
##  /var/lib/openframe-firmware) and the boot carries on. If a write won't verify, it keeps
##  trying and never lets the boot carry on: switching off then could leave a unit that
##  won't start.
##
##  The panel, while it works, has the look of OpenFrame Flash's (openframe-scripts): the
##  console's 100x30 characters, 16 colours, a blue band across the top, the steps with a
##  tick for each one done, a bar and the time left for the current one, and a red screen
##  of its own for a write that didn't verify. (OpenFrame Flash runs the updater itself, on
##  its own screen, and clears the pending mark: this isn't used during a flash.)
##
##  What it did is also kept in last-flash.log beside the pending mark, as the journal on
##  these units lives in memory and goes with the restart.

VERSION="26.11.4"
PENDING=/var/lib/openframe-firmware/pending
LOCKREBOOT=/var/lib/openframe-firmware/lock-reboot
LOGF=/var/lib/openframe-firmware/last-flash.log
UPDATE=/usr/local/sbin/of-firmware-update
IMG=/usr/lib/openframe-firmware/of1-blw.bin
TTY=/dev/tty1
# The panel's characters (█, ░, √, ►) are UTF-8, whatever locale the service gets.
export LC_ALL=C.UTF-8

# To the journal, and to $LOGF once this run has started it.
LOGGING=""
log() {
	echo "of-firmware-boot: $*"
	[ -n "$LOGGING" ] && echo "of-firmware-boot: $*" >> "$LOGF"
	return 0
}
# Command output, the same way.
log_out() {
	printf '%s\n' "$1"
	[ -n "$LOGGING" ] && printf '%s\n' "$1" >> "$LOGF"
	return 0
}

## The panel.

# White for what's happening now, grey for the rest, yellow for what needs heeding, dark
# grey only for the step still to come (it's too faint on a tired panel for anything
# that has to be read).
C_RST=$'\033[0m'; C_GRY=$'\033[0;37m'; C_DGR=$'\033[1;30m'; C_WHT=$'\033[1;37m'
C_GRN=$'\033[0;32m'; C_LGN=$'\033[1;32m'; C_YEL=$'\033[1;33m'; C_LCY=$'\033[1;36m'; C_LRD=$'\033[1;31m'
B_BLU=$'\033[44m'; B_RED=$'\033[41m'

STEPS=("Bring the firmware up to date" "Restart on the new firmware")
# Rows: the band (two deep, its title on the second), two blank lines, the intro, the
# steps (four rows each: the step, its working line, the blocks, a blank), the line and
# this unit's details at the bottom.
# The line two rows above this unit's details: OpenFrame Flash's screen has its overall
# bar there, under its line, and with nothing between them the line looked high.
BAND_ROWS=2; BAND_TITLE=2; R_INTRO=5; R_STEPS=9; R_SEP=27; R_FOOT=29
# Set once the firmware is written: the blocks line stays, all ticked, under step 1.
WRITTEN=""
# Seconds for each part of the update (reading the chip, then each block written and
# read back twice), until the first part done says how this unit's chip is getting on.
PART_EST=4
NEW=""; STEP=0; LABEL=""; T0=0; DRAWN=""; CONSOLE_LEVEL=""

tty_out() { [ -w "$TTY" ] && printf '%s' "$@" >> "$TTY"; }

# "\033[row;colH" then $3, coloured $4, the rest of the line cleared first if $5.
at() {
	local S=$'\033['"$1;$2H"
	[ -n "${5:-}" ] && S+=$'\033[2K'
	printf '%s%s%s%s' "$S" "${4:-}" "$3" "$C_RST"
}

# A bar $1 characters wide, $2 per mille full, in colour $3.
bar() {
	local W="$1" N=$(( $1 * $2 / 1000 )) S="" i
	(( N > W )) && N=$W
	S+="$3"; for ((i = 0; i < N; i++)); do S+="█"; done
	S+="$C_GRY"; for ((i = N; i < W; i++)); do S+="░"; done
	printf '%s%s' "$S" "$C_RST"
}

# The band across the top: background $1, title $2 at the left, $3 at the right.
band() {
	local L="  $2" R="$3  " PAD BLANK i
	PAD=$(( 100 - ${#L} - ${#R} ))
	BLANK=$(printf '%100s' '')
	for ((i = 1; i <= BAND_ROWS; i++)); do
		if (( i == BAND_TITLE )); then
			printf '\033[%d;1H%s%s%s%*s%s' $i "$1" "$C_WHT" "$L" "$PAD" "" "$R"
		else
			printf '\033[%d;1H%s%s' $i "$1" "$BLANK"
		fi
	done
	printf '%s' "$C_RST"
}

# Other things' messages on the console would land on top of the panel: systemd's status
# messages go off with its signal for that (sent again at every update, as the boot's
# own reloads can put them back), the kernel's through the console log level. Both go
# back as they were for a boot that carries on.
console_hush() { kill -s RTMIN+21 1 2>/dev/null; }
console_quiet() {
	console_hush
	CONSOLE_LEVEL=$(cut -f1 /proc/sys/kernel/printk 2>/dev/null)
	dmesg -n 1 2>/dev/null
	setterm -blank 0 -powersave off > "$TTY" 2>/dev/null < "$TTY"
}
# With an update pending this runs before basic.target (of-firmware-generator), so before
# D-Bus is up, and a call over the bus would wait for it. Then a one-off unit makes the call
# once D-Bus is there (systemd-run reaches systemd through its own socket).
console_restore() {
	if systemctl -q is-active dbus.service; then
		busctl --timeout=5 call org.freedesktop.systemd1 /org/freedesktop/systemd1 \
			org.freedesktop.systemd1.Manager SetShowStatus s "" >/dev/null 2>&1
	else
		systemd-run --no-block --quiet --collect --unit=of-firmware-show-status \
			-p After=dbus.service -p Wants=dbus.service busctl call org.freedesktop.systemd1 \
			/org/freedesktop/systemd1 org.freedesktop.systemd1.Manager SetShowStatus s "" >/dev/null 2>&1
	fi
	[ -n "$CONSOLE_LEVEL" ] && dmesg -n "$CONSOLE_LEVEL" 2>/dev/null
}

# Puts the boot splash away and clears the panel, with no cursor.
panel_clear() {
	command -v plymouth >/dev/null && plymouth --ping 2>/dev/null && plymouth quit 2>/dev/null
	tty_out $'\033[0m\033[2J\033[?25l'
}

# The panel back to a plain console, for a boot that carries on.
panel_release() {
	[ -n "$DRAWN" ] && tty_out $'\033[0m\033[2J\033[H\033[?25h'
	console_restore
}

# Seconds since the unit started: unlike the clock, this never jumps (OpenFrames have no
# clock battery, and the network can put the clock right part way through).
uptime_s() { local U; read -r U _ < /proc/uptime; echo "${U%.*}"; }

seconds_left() {
	if (( $1 >= 60 )); then printf '%d min %02d s left' $(($1 / 60)) $(($1 % 60)); else printf '%d s left' "$1"; fi
}

# The firmware the unit started with, for the bottom line: ours by its version, stock by
# the carrier it came from ("O2": it has no version of its own), going by FWCHECK, what
# of-firmware-update's check said: a block it gave one stock image's name alone says
# which (blocks 5 and 6 are the same in all three: "5:o2-stock+"). "OpenPeak" if it
# named none.
FWCHECK=""
fw_name() {
	local V L
	V=$(cat /sys/class/dmi/id/bios_version 2>/dev/null)
	if [ -n "$V" ]; then echo "$V"; return; fi
	if [ "$(cat /sys/class/dmi/id/bios_vendor 2>/dev/null)" = "BirdsLikeWires" ]; then echo "unknown"; return; fi
	L=$(printf '%s\n' "$FWCHECK" | sed -n 's/.*blocks that differ from [^:]*: //p' | tr ' ' '\n' |
		sed -n 's/^[0-9]*:\(o2-stock\|verizon\|telstra\)$/\1/p' | head -1)
	case "$L" in
		o2-stock) echo "O2" ;;
		verizon) echo "Verizon" ;;
		telstra) echo "Telstra" ;;
		*) echo "OpenPeak" ;;
	esac
}

# The working screen, drawn afresh, step $1 (0 or 1) current, its line saying $2.
draw() {
	local i R MARK COL OUT MAC FW
	STEP=$1; LABEL=$2; T0=$(uptime_s)
	console_hush
	[ -n "$DRAWN" ] || { panel_clear; DRAWN=1; }
	OUT=$(band "$B_BLU" "OpenFrame Firmware Update v$VERSION" "${NEW:+Release $NEW}")
	OUT+=$(at $R_INTRO 4 "Updating this OpenFrame's firmware${NEW:+ to $NEW}." "$C_WHT" 1)
	if (( STEP == 0 )); then
		OUT+=$(at $((R_INTRO + 1)) 4 "Please don't switch off or unplug! Firmware is being written." "$C_YEL" 1)
	else
		OUT+=$(at $((R_INTRO + 1)) 4 "Please leave switched on! Update will continue after rebooting." "$C_YEL" 1)
	fi
	for i in "${!STEPS[@]}"; do
		R=$((R_STEPS + 4 * i))
		if (( i < STEP )); then MARK="√"; COL="$C_LGN"
		elif (( i == STEP )); then MARK="►"; COL="$C_YEL"
		else MARK="·"; COL="$C_DGR"; fi
		OUT+=$(at $R 5 "$MARK" "$COL" 1)
		if (( i < STEP )); then OUT+=$(at $R 8 "${STEPS[$i]}" "$C_GRY"); OUT+=$(at $R 62 "done" "$C_GRN")
		elif (( i == STEP )); then OUT+=$(at $R 8 "${STEPS[$i]}" "$C_WHT")
		else OUT+=$(at $R 8 "${STEPS[$i]}" "$C_DGR"); fi
		# Its working line, and the line under it (the blocks being written).
		OUT+=$(at $((R + 1)) 1 "" "" 1)
		OUT+=$(at $((R + 2)) 1 "" "" 1)
	done
	OUT+=$(at $R_SEP 4 "$(printf '─%.0s' {1..94})" "$C_GRY" 1)
	MAC=$(cat /var/lib/of-netplan/lan.mac 2>/dev/null)
	# Once it's written, the release too, as OpenFrame Flash's screen has it.
	FW=$(fw_name)
	[ -n "$WRITTEN" ] && [ -n "$NEW" ] && FW+=", $NEW from the next start"
	OUT+=$(at $R_FOOT 4 "${MAC:+MAC: ${MAC^^}   }Firmware: $FW" "$C_GRY" 1)
	tty_out "$OUT"
	[ -n "$WRITTEN" ] && blocks_row ${#PARTS_LIST[@]} ""
}

# The update's detail, from what its check said ($1), for the line under its bar
# (blocks_row): PARTS_LIST, the blocks it writes in order from its plan line ("plan:
# write blocks 10 11 9"; before 26.11.5, block 10 written headers last was three writes, "10
# bodies", "10 driver header", "10 marker header"). What the firmware is now goes on the
# bottom line (fw_name).
PARTS_LIST=()
detail() {
	local B
	PARTS_LIST=()
	local OTHERS=() ALL=()
	for B in $(printf '%s\n' "$1" | sed -n 's/.*plan: write blocks* \([0-9 ]*\).*/\1/p'); do
		ALL+=("$B")
		[ "$B" = 10 ] || OTHERS+=("$B")
	done
	if printf '%s\n' "$1" | grep -q 'headers last'; then
		# An updater before 26.11.5, in the order it writes: block 10's bodies, the others,
		# then its two headers.
		PARTS_LIST=("10 bodies" "${OTHERS[@]}" "10 driver header" "10 marker header")
	else
		# In the order the plan line gives them (from 26.11.5: "plan: write blocks 9 10 11 9",
		# block 9 twice when it closes one signpost and opens the next).
		PARTS_LIST=("${ALL[@]}")
	fi
}

# The line under step 1's bar: each block the update writes, in order, with a tick once
# written and ► while it's being written; $1 is how many are written, $2 set while the
# next one is being written.
blocks_row() {
	local i S="" R=$((R_STEPS + 2))
	(( ${#PARTS_LIST[@]} > 0 )) || return 0
	for i in "${!PARTS_LIST[@]}"; do
		if (( i < $1 )); then S+="$C_GRY${PARTS_LIST[$i]} $C_LGN√$C_RST   "
		elif (( i == $1 )) && [ -n "$2" ]; then S+="$C_WHT${PARTS_LIST[$i]} $C_YEL►$C_RST   "
		else S+="$C_DGR${PARTS_LIST[$i]}$C_RST     "; fi
	done
	tty_out "$(at $R 10 "Blocks" "$C_GRY" 1)$(at $R 18 "$S")"
}

# The current step's line: its label, and with $1 of $2 a bar, a percentage and the time
# left (going by how the step is getting on, or by $3 seconds for all of it at first).
show() {
	local F R OUT EL LEFT
	console_hush
	R=$((R_STEPS + 1 + 4 * STEP))
	OUT=$(at $R 10 "$LABEL" "$C_LCY" 1)
	if [ -n "${2:-}" ]; then
		F=$(( $2 > 0 ? $1 * 1000 / $2 : 0 )); (( F > 1000 )) && F=1000
		EL=$(( $(uptime_s) - T0 ))
		if (( F >= 50 && EL >= 4 )); then LEFT=$(( EL * (1000 - F) / F ))
		else LEFT=$(( ${3:-0} * (1000 - F) / 1000 )); fi
		(( LEFT > 3600 )) && LEFT=3600
		OUT+=$(at $R 43 "$(bar 30 $F "$C_LCY")")
		OUT+=$(at $R 75 "$(printf '%3d%%' $((F / 10)))" "$C_WHT")
		OUT+=$(at $R 81 "$(seconds_left $LEFT)" "$C_GRY")
	fi
	tty_out "$OUT"
}

# Step 2: "$1 Restarting in N seconds." for five seconds, then the restart. The service
# then waits for the shutdown to stop it, so the login prompt (ordered after it) never
# lands on the screen first.
restart() {
	local N
	draw 1 "$1"
	for N in 5 4 3 2 1; do
		LABEL="$1 Restarting in $N second$([ $N -gt 1 ] && echo s)."
		show
		sleep 1
	done
	LABEL="$1 Restarting now."
	show
	log "restarting: $1"
	# Stoppable again (see the update, below): the shutdown this starts stops us.
	trap - HUP INT TERM
	# Straight to systemd (as root, through its own socket), as "systemctl reboot" does after
	# asking logind over D-Bus. Before basic.target (of-firmware-generator) D-Bus can't start
	# until this service is done, so that question would wait 90 s for nothing.
	systemctl --no-block start --job-mode=replace-irreversibly reboot.target
	exec sleep 120
}

# A write that didn't verify: red, and why the unit mustn't be switched off. $1 the try
# that comes next.
screen_retry() {
	local OUT ROW=$R_INTRO L COL TXT
	console_hush
	panel_clear; DRAWN=1
	OUT=$(band "$B_RED" "OpenFrame Firmware Update v$VERSION" "Don't switch off")
	for L in "${C_LRD}The firmware didn't apply correctly, so it's being written again." "" \
		"${C_YEL}Please don't switch off or unplug this OpenFrame! It may not start if it's switched off now." "" \
		"${C_GRY}Repeating until the firmware writes correctly (try $1 next)."; do
		COL="$C_WHT"
		if [[ "$L" =~ ^($'\033'\[[0-9\;]*m)(.*)$ ]]; then COL="${BASH_REMATCH[1]}"; L="${BASH_REMATCH[2]}"; fi
		while IFS= read -r TXT; do
			OUT+=$(at $ROW 4 "$TXT" "$COL")
			ROW=$((ROW + 1))
		done < <(printf '%s\n' "$L" | fold -s -w 92)
	done
	tty_out "$OUT"
	# The working screen again next time, on a clear panel.
	DRAWN=""
}

## The update.

[ -f $PENDING ] || exit 0

# A fresh log for this run. The clock may be wrong this early (no clock battery), so the
# time since power-on too.
if { echo "of-firmware-boot $VERSION, $(date '+%Y-%m-%d %H:%M:%S') by the unit's clock, $(uptime_s) s after power-on"; } > "$LOGF" 2>/dev/null; then
	LOGGING=1
fi

CHECK=$($UPDATE --check 2>&1); rc=$?
log_out "$CHECK"
case $rc in
	0) log "the firmware is up to date"; rm -f $PENDING $LOCKREBOOT; exit 0 ;;
	3) log "firmware not recognised: left alone"; rm -f $PENDING $LOCKREBOOT; exit 0 ;;
	5) ;;
	*) log "could not check the firmware (exit $rc): will try at the next boot"; exit 0 ;;
esac

# The release, as the updater named it (it picks the image for this chip's model, OF1 or OF2),
# else from the OF1 image.
NEW=$(echo "$CHECK" | sed -n 's/.*blocks that differ from \([^: ]*\):.*/\1/p' | head -1)
[ -n "$NEW" ] || NEW=$(grep -aoE 'BirdsLikeWires OpenFrame EFI [0-9]+\.[0-9]+\.[0-9]+(-dev[0-9]+)? \(OF[12]\)' "$IMG" 2>/dev/null | head -1 | awk '{print $4}')
# The parts: reading the chip, then each block's write (block 10 headers last is three).
detail "$CHECK"
FWCHECK="$CHECK"
PARTS=${#PARTS_LIST[@]}
(( PARTS > 0 )) || PARTS=6
PARTS=$((PARTS + 1))

# Each run of of-firmware-update keeps its chip dumps (about 7 MB) in a folder of its own
# in /tmp, which is in memory (192 MB on an OpenFrame 1). Before each try, all but the
# newest go: a write retried for as long as it takes would otherwise fill /tmp in about
# half an hour, and the updater, unable to make its folder, would say it had written
# nothing. (Its own dumps go, as ever, when the unit next starts.)
DUMPS="/tmp/of-firmware-update."
dumps_prune() {
	ls -1dt "$DUMPS"* 2>/dev/null | tail -n +2 | while IFS= read -r D; do rm -rf -- "$D"; done
}

console_quiet
OUTF=$(mktemp /tmp/of-firmware-boot.XXXXXX)
trap 'rm -f "$OUTF"' EXIT
tries=0
# Set once a try hasn't verified: from then on, only finishing the job counts. A later
# try's "nothing was written, the chip is as it was" is about that try alone, and the
# chip as it was is already part written, so it's taken as another that didn't verify,
# whatever it says, and never lets the boot carry on.
torn=""
# Nothing but finishing stops the update: a shutdown, a Ctrl-C or a dropped session waits
# for it (of-firmware-update ignores them too from its first write, and of-firmware.service
# never follows with a kill), as stopping between blocks can leave a unit that won't start.
trap '' HUP INT TERM
while :; do
	tries=$((tries + 1))
	dumps_prune
	draw 0 "Reading the firmware chip"
	show 0 1 $(( PARTS * PART_EST ))
	blocks_row 0 ""
	: > "$OUTF"
	$UPDATE > "$OUTF" 2>&1 &
	PID=$!
	LAST=0; TLAST=$(uptime_s); TPLAN=""
	while kill -0 $PID 2>/dev/null; do
		DONE=$(grep -cE ': plan: |: block [0-9]+ written and verified|: block 10: (bodies|driver header|marker header) written' "$OUTF")
		T=$(uptime_s)
		if (( DONE != LAST )); then
			(( LAST == 0 )) && TPLAN=$T
			LAST=$DONE; TLAST=$T
		fi
		# How long a part takes: as the parts done so far took, once one has.
		EST=$PART_EST
		if [ -n "$TPLAN" ] && (( DONE > 1 )); then
			EST=$(( (TLAST - TPLAN) / (DONE - 1) ))
			(( EST < 1 )) && EST=1
		fi
		FRAC=$(( (T - TLAST) * 1000 / EST ))
		(( FRAC > 900 )) && FRAC=900
		if (( DONE == 0 )); then LABEL="Reading the firmware chip"
		elif (( DONE < PARTS )); then LABEL="Writing the firmware: $DONE of $((PARTS - 1))"
		else LABEL="Checking the firmware"; fi
		show $(( DONE * 1000 + FRAC )) $(( PARTS * 1000 )) $(( PARTS * PART_EST ))
		if (( DONE == 0 )); then blocks_row 0 ""; else blocks_row $((DONE - 1)) 1; fi
		sleep 1
	done
	wait $PID; rc=$?
	log_out "$(cat "$OUTF")"
	if [ -n "$torn" ] && [ $rc != 0 ]; then
		log "an earlier try didn't verify, so exit $rc is taken as another that didn't"
		rc=2
	fi
	case $rc in
		0)
			rm -f $PENDING $LOCKREBOOT
			sync
			WRITTEN=1
			restart "The firmware is up to date." ;;
		4)
			# Flash locked until the next reset (BlwMac.efi stored a MAC this boot). Once.
			if [ -f $LOCKREBOOT ]; then
				rm -f $LOCKREBOOT
				log "flash still locked after a restart: will try at the next boot"
				panel_release
				exit 0
			fi
			touch $LOCKREBOOT
			sync
			restart "The firmware chip is locked until rebooted." ;;
		3)
			rm -f $PENDING $LOCKREBOOT
			log "firmware not recognised: left alone"
			panel_release
			exit 0 ;;
		1)
			log "update refused, nothing written (see above): will try at the next boot"
			panel_release
			exit 0 ;;
		*)
			# 2: a write didn't verify. Never carry on booting: keep trying.
			torn=1
			log "the firmware didn't verify (exit $rc): trying again (attempt $((tries + 1)))"
			screen_retry $((tries + 1))
			if [ $tries -lt 3 ]; then sleep 5; else sleep 60; fi ;;
	esac
done
